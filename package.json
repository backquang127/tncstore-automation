{
  "name": "tncstore-automation",
  "version": "1.0.0",
  "scripts": {
    "test": "npx playwright test",
    "allure:clear": "rimraf allure-results allure-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test:allure": "npm run allure:clear && npx playwright test && npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/xlsx": "^0.0.35",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
