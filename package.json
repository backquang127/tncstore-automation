{
  "name": "tncstore-automation",
  "version": "1.0.0",
  "scripts": {
    "test": "npx playwright test",
    "test:parallel": "npx playwright test --workers=5",
    "allure:clear": "rimraf ./reports/allure-results ./reports/allure-report",
    "allure:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "allure:open": "allure open ./reports/allure-report",
    "test:allure": "npm run allure:clear && npx playwright test && npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^24.9.1",
    "@types/xlsx": "^0.0.35",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1",
    "cross-env": "^10.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
